# 复制本文件为 .streamlit/secrets.toml 并填入真实密钥（该文件已被 .gitignore 忽略，不会上传）
# 部署到 Streamlit Cloud 时，在 App 设置 → Secrets 中粘贴同样内容

# DeepSeek 对话模型（必填，用于生成回答）
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY = "sk-xxxxxxxxxxxxxxxx"

# SiliconFlow 向量模型（可选；不填则自动降级为关键词检索，问答功能仍可用）
# 申请地址：https://siliconflow.cn （免费额度即可）
SILICONFLOW_API_KEY = "sk-xxxxxxxxxxxxxxxx"
